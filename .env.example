# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.

# Entorno activo: produccion | preproduccion | prueba
APP_ENV=prueba
APP_LOG_LEVEL=INFO

# ---------------- PostgreSQL ----------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prueba
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_DB_PRODUCCION=produccion
POSTGRES_DB_PREPRODUCCION=preproduccion
POSTGRES_DB_PRUEBA=prueba

# ---------------- Azure CLI ----------------
# Vacío = usa la sesión de `az login`. Para Service Principal completa los tres.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# AZURE_CLI_PATH=C:\Program Files\Microsoft SDKs\Azure\CLI2\wbin\az.cmd

# ---------------- AWS S3 ----------------
# LocalStack: llaves "test"/"test" y endpoint http://localhost:4566
# AWS real: tus llaves (o vacías para usar ~/.aws / rol IAM) y endpoint vacío.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
